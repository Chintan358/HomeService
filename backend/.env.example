# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Home Services Booking API"
API_V1_PREFIX=/api/v1
DEBUG=True

# Server Bindings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://home-service-delta-lyart.vercel.app/"]

# Database Connection (MySQL)
MYSQL_SERVER=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=2hbcNGEmVZo3x5k.root
MYSQL_PASSWORD=uKy1EpinTZ7N4I0l
MYSQL_DB=homeservices
DATABASE_URL=mysql://2hbcNGEmVZo3x5k.root:uKy1EpinTZ7N4I0l@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/homeservices

# JWT Authentication & Cryptography
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
