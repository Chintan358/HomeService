# ==============================================================================
# ROOT / GLOBAL ENVIRONMENT TEMPLATE
# (See backend/.env.example and frontend/.env.example for service-specific details)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Home Services Booking SaaS"

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Database Configuration (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=homeservices
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/homeservices

# Security / JWT
SECRET_KEY=generate_a_super_secret_key_minimum_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
